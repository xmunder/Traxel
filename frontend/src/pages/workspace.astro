---
import Preview from '../components/Preview.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/vectorizer.css';
---

	<BaseLayout
		title="Traxel — Comparison Workspace"
		pathname="/workspace"
		robots="noindex, nofollow"
		bodyClass="workspace-review-body"
		fonts="traxel"
	>
		<div class="workspace-review-page" data-vectorizer-app data-page="workspace" data-home-path="/" data-state="idle">
			<header class="workspace-review-header">
				<div class="workspace-review-header__brand">
					<svg class="workspace-review-header__logo" width="34" height="34" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
						<path d="M18 3L31 10.5V25.5L18 33L5 25.5V10.5L18 3Z" stroke="#4ade80" stroke-width="2" stroke-linejoin="round"></path>
						<path d="M18 3V18M18 18L31 10.5M18 18L5 10.5M18 18V33" stroke="#4ade80" stroke-width="1.5" stroke-linejoin="round" opacity="0.7"></path>
						<path d="M11.5 14.25L24.5 21.75M24.5 14.25L11.5 21.75" stroke="#86efac" stroke-width="1.2" opacity="0.5"></path>
					</svg>
					<div class="workspace-review-header__wordmark">
						<strong>TRAXEL</strong>
						<span>VECTOR WORKSPACE</span>
					</div>
				</div>
				<div class="workspace-review-header__tools">
					<span class="workspace-review-header__status"><i></i>ENGINE READY</span>
					<a class="workspace-review-header__action" href="/">New Upload</a>
				</div>
			</header>

		<main class="workspace-review-main" id="main-content">
			<Preview />
		</main>
	</div>

	<script>
		import { initVectorizerApp } from '../lib/vectorizer-app';

		initVectorizerApp();
	</script>
</BaseLayout>
