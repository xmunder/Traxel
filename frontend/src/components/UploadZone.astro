---
import { Upload } from '@lucide/astro';
---

<section class="mvp-upload-card" aria-labelledby="upload-title">
	<form class="mvp-upload-card__frame" data-upload-form novalidate>
		<input
			id="image-input"
			class="sr-only"
			data-image-input
			type="file"
			name="image"
			accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp"
			aria-label="Choose an image file to vectorize"
		/>

		<div class="mvp-upload-card__tilt">
			<div class="mvp-upload-card__shadow" aria-hidden="true"></div>
			<div class="mvp-upload-card__dropzone" data-dropzone role="group" aria-describedby="upload-status upload-error">
				<button
					type="button"
					class="mvp-upload-card__surface-trigger"
					data-upload-surface
					data-upload-trigger
					aria-labelledby="upload-title"
					aria-describedby="upload-status upload-error"
				>
					<span class="sr-only">Choose an image file to vectorize</span>
				</button>
				<div class="mvp-upload-card__sheen" aria-hidden="true"></div>

				<div class="mvp-upload-card__title-group">
					<h2 id="upload-title">Drag and Drop</h2>

					<div class="mvp-upload-card__icon" aria-hidden="true">
						<Upload aria-hidden="true" focusable="false" stroke-width={2.2} />
						<div class="mvp-upload-card__icon-bar"></div>
					</div>
				</div>

				<div class="mvp-upload-card__button-wrap">
					<span class="mvp-upload-card__button-bracket mvp-upload-card__button-bracket--left" aria-hidden="true"></span>
					<button type="button" class="mvp-upload-card__button neon-btn" data-upload-trigger>
						Upload Image
					</button>
					<span class="mvp-upload-card__button-bracket mvp-upload-card__button-bracket--right" aria-hidden="true"></span>
				</div>

				<p class="mvp-upload-card__microcopy" data-selected-file>OR SELECT A LOCAL FILE</p>
				<p class="mvp-upload-card__statecopy sr-only" data-state-copy aria-live="polite"></p>
				<p class="status-line" id="upload-status" data-status aria-live="polite"></p>
				<p class="error-line" id="upload-error" data-error aria-live="assertive" hidden></p>
			</div>
		</div>
	</form>
</section>
